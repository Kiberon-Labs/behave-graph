# TTS provider for `pnpm voice`. Copy to .env (gitignored) and fill in a key.
# elevenlabs (default) | openai
TTS_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=
# Optional overrides:
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Only needed when TTS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx
