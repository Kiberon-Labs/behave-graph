---
import EmbeddedEditor from '~/components/EmbeddedEditor.tsx';

// Respect Astro's configured `base` so the "back to docs" link works whether
// the site is served from a subpath (e.g. /behave-graph/) or the domain root.
const docsHref = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editor | Behave Graphs</title>
    <meta
      name="description"
      content="The full-screen Behave Graph editor, running entirely in your browser."
    />
    <style>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #1e1e1e;
        overflow: hidden;
      }
      #editor-root {
        height: 100dvh;
        width: 100vw;
      }
      /* Small unobtrusive link back to the docs. Bottom-left keeps it clear of
         the editor's top menubar. */
      .editor-back {
        position: fixed;
        bottom: 0.75rem;
        left: 0.75rem;
        z-index: 20;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.7rem;
        font: 500 0.8rem/1 system-ui, sans-serif;
        color: #e6e6e6;
        text-decoration: none;
        background: rgba(30, 30, 30, 0.85);
        border: 1px solid #3a3a3a;
        border-radius: 999px;
        backdrop-filter: blur(4px);
      }
      .editor-back:hover {
        background: rgba(50, 50, 50, 0.95);
      }
    </style>
  </head>
  <body>
    <div id="editor-root">
      <EmbeddedEditor client:only="react" height="100dvh" bordered={false} />
    </div>
    <a class="editor-back" href={docsHref}>&larr; Docs</a>
  </body>
</html>
