{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": [
        "src/index.ts"
    ],
    "ignorePatterns": [
        "**/*.generated.ts",
        "**/dist/**",
        "**/tests/**"
    ],
    "rules": {
        "unused-files": "error",
        "unused-exports": "warn",
        "unused-types": "off"
    }
}