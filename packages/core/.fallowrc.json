{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": [
        "src/index.ts"
    ],
    "ignorePatterns": [
        "**/*.generated.ts",
        "**/dist/**",
        "**/tests/**"
    ],
    "rules": {
        "unused-files": "error",
        "unused-exports": "warn",
        "unused-types": "off"
    },
    "ignoreExports": [
        {
            "file": "src/Profiles/Core/Values/BooleanNodes.ts",
            "exports": [
                "*"
            ]
        },
        {
            "file": "src/Profiles/Core/Values/FloatNodes.ts",
            "exports": [
                "*"
            ]
        },
        {
            "file": "src/Profiles/Core/Values/IntegerNodes.ts",
            "exports": [
                "*"
            ]
        },
        {
            "file": "src/Profiles/Core/Values/StringNodes.ts",
            "exports": [
                "*"
            ]
        }
    ]
}