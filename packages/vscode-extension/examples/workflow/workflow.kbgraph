{
  "v": "1.0.0",
  "name": "Workflow Example",
  "annotations": {},
  "data": {},
  "flow": {
    "nodes": [
      {
        "id": "start",
        "type": "lifecycle/onStart",
        "flows": {
          "flow": {
            "nodeId": "http",
            "socket": "flow"
          }
        }
      },
      {
        "id": "http",
        "type": "workflow/httpRequest",
        "parameters": {
          "url": {
            "value": "https://api.example.com/data"
          }
        },
        "flows": {
          "completed": {
            "nodeId": "branch",
            "socket": "flow"
          }
        }
      },
      {
        "id": "ok",
        "type": "workflow/statusOk",
        "parameters": {
          "status": {
            "link": {
              "nodeId": "http",
              "socket": "status"
            }
          }
        }
      },
      {
        "id": "branch",
        "type": "flow/branch",
        "parameters": {
          "condition": {
            "link": {
              "nodeId": "ok",
              "socket": "ok"
            }
          }
        },
        "flows": {
          "true": {
            "nodeId": "setOk",
            "socket": "flow"
          },
          "false": {
            "nodeId": "setErr",
            "socket": "flow"
          }
        }
      },
      {
        "id": "setOk",
        "type": "workflow/setResult",
        "configuration": {
          "key": "result"
        },
        "parameters": {
          "value": {
            "link": {
              "nodeId": "http",
              "socket": "body"
            }
          }
        }
      },
      {
        "id": "setErr",
        "type": "workflow/setResult",
        "configuration": {
          "key": "error"
        },
        "parameters": {
          "value": {
            "link": {
              "nodeId": "http",
              "socket": "body"
            }
          }
        }
      }
    ],
    "variables": [],
    "customEvents": []
  },
  "nodes": [
    {
      "id": "start",
      "type": "behaveNode",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "type": "lifecycle/onStart",
        "configuration": {},
        "ports": {}
      },
      "width": 150,
