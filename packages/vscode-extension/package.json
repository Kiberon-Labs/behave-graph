{
  "name": "kiberon-labs-behave-engine-vscode",
  "displayName": "kiberon-labs Graph extension",
  "description": "Run behave graphs locally in VS Code",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-2.0",
  "publisher": "kiberon-labs",
  "author": "kiberonlabsdev",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Extension Packs",
    "Visualization"
  ],
  "pricing": "Free",
  "icon": "media/logo.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Using ESLint is not possible in virtual workspaces."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension requires workspace trust because it loads configuration files and code from the workspace and executes it."
    }
  },
  "contributes": {
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == kiberon-labs-behave-graph",
          "command": "kiberon-labs-behave-graph.executeGraph",
          "group": "z_commands"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".kbgraphrc",
        "url": "https://schemas.kiberon-labs.co.za/v1/kbgraphrc.json"
      }
    ],
    "languages": [
      {
        "id": "kiberon-labs-behave-graph",
        "aliases": [
          "Behave Graph",
          "kiberon-labs Behave Graph"
        ],
        "extensions": [
          ".kbgraph"
        ],
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "kiberon-labs-behave-graph.graphFile",
        "displayName": "Behave Graph file",
        "selector": [
          {
            "filenamePattern": "*.kbgraph"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "kiberon-labs-behave-graph.graph.new",
        "title": "Create new Behave Graph file",
        "category": "Graph Engine"
      },
      {
        "command": "kiberon-labs-behave-graph.openGraphEngine",
        "title": "Open Graph Engine"
      },
      {
        "command": "kiberon-labs-behave-graph.executeGraph",
        "title": "Execute Graph"
      },
      {
        "command": "kiberon-labs-behave-graph.mcpStatus",
        "title": "Show MCP Server Status",
        "category": "Graph Engine"
      }
    ],
    "configuration": {
      "title": "Behave Graph",
      "properties": {
        "behaveGraph.mcp.httpServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the MCP HTTP server so external agents (Claude Desktop, OpenCode, Cursor, etc.) can connect via URL."
        },
        "behaveGraph.mcp.httpServer.port": {
          "type": "number",
          "default": 3100,
          "description": "Port for the MCP HTTP server."
        },
        "behaveGraph.mcp.vscodeProvider.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register MCP tools as a VS Code MCP Server Definition Provider so VS Code Copilot can discover and use them."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "kiberon-labs-behave-graph.mcp",
        "label": "Behave Graph Editor"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiberon-Labs/behave-graph"
  },
  "scripts": {
    "vite": "vite",
    "build:app": "vite build",
    "vscode:prepublish": "yarn run build",
    "build": "npm run check-types  && npm run build:app && npm run build:ext",
    "build:ext": "node esbuild.js",
    "dev": "npm-run-all -p dev:*",
    "dev:ext": "node esbuild.js  --watch",
    "dev:app": "vite build --watch",
    "format": "oxfmt",
    "dev:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "pretest": "yarn run build-tests && yarn run build ",
    "check-types": "tsc --noEmit",
    "test:e2e": "vscode-test"
  },
  "dependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "@kiberon-labs/behave-graph-flow": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "rc-dock": "4.0.0-alpha.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.9",
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "vite": "^7.2.4",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0"
  }
}