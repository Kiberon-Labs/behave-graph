{
  "name": "@kiberon-labs/behave-graph-flow",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entry.css": "./dist/entry.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "audit": "fallow",
    "dev": "tsdown --watch src",
    "build": "tsdown",
    "test": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "vitest run --config vitest.visual.config.ts --update",
    "check": "oxfmt --check",
    "format": "oxfmt",
    "lint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json"
  },
  "devDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@types/dagre": "^0.7.53",
    "@types/graphlib": "^2.1.12",
    "@types/react": "^19.2.6",
    "@types/uuid": "^8.3.4",
    "@vitest/browser": "^4.0.10",
    "@vitest/browser-playwright": "4.0.10",
    "autoprefixer": "^10.4.22",
    "fallow": "^2.89.0",
    "happy-dom": "^20.4.0",
    "jsdom": "^27.3.0",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "playwright": "^1.60.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reactflow": "^11.11.4",
    "storybook": "^10.0.8",
    "tsdown": "^0.16.5",
    "unplugin-lightningcss": "^0.4.3",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10",
    "vitest-browser-react": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiberon-Labs/behave-graph",
    "directory": "packages/flow"
  },
  "author": "kiberonlabsdev",
  "bugs": "https://github.com/Kiberon-Labs/behave-graph/issues",
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@reactflow/node-resizer": "^2.2.14",
    "@tiptap/extension-youtube": "^3.27.1",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@vscode-elements/react-elements": "^2.4.0",
    "classnames": "^2.3.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.0",
    "fuse.js": "^7.1.0",
    "graphlib": "^2.1.8",
    "iconoir-react": "^7.11.0",
    "json-edit-react": "^1.29.0",
    "rc-dock": "4.0.0-alpha.2",
    "rc-menu": "^9.16.1",
    "react-colorful": "^5.6.1",
    "react-error-boundary": "^6.0.0",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys": "^2.0.0",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^8.3.2",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "reactflow": "^11.1.1"
  }
}