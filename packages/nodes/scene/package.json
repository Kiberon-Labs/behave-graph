{
  "name": "@kiberon-labs/behave-graph-scene",
  "version": "2.0.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "source": "./src/index.ts",
  "behaveGraph": {
    "manifest": "./dist/behave-graph.manifest.json"
  },
  "scripts": {
    "build": "tsdown && behave-graph-manifest dist/manifest.source.js --out dist",
    "check": "oxfmt --check",
    "format": "oxfmt",
    "test": "vitest",
    "dev": "tsdown --watch src",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiberon-Labs/behave-graph",
    "directory": "packages/nodes/scene"
  },
  "bugs": "https://github.com/Kiberon-Labs/behave-graph/issues",
  "devDependencies": {
    "@kiberon-labs/behave-graph-flow": "workspace:*",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@types/glob": "^8.0.0",
    "@types/node": "^24.10.1",
    "@types/offscreencanvas": "^2019.7.0",
    "@types/react": "^19.2.6",
    "@types/three": "0.152.1",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "react": "19.2.4",
    "storybook": "^10.0.8",
    "tsdown": "^0.16.5",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "react-dom": "19.2.4",
    "vitest": "^4.0.10"
  },
  "author": "kiberonlabsdev",
  "license": "ISC",
  "peerDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "three": "0.152.2",
    "three-stdlib": "^2.22.4"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "@vscode-elements/react-elements": "^2.4.0"
  }
}