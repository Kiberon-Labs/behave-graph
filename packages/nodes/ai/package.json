    "test": "vitest --passWithNoTests",
    "dev": "tsdown --watch src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
