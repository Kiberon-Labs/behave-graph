{
  "name": "@kiberon-labs/behave-graph-nodes-slack",
  "version": "1.0.0",
  "type": "module",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && behave-graph-manifest dist/manifest.source.js --out dist",
    "check": "oxfmt --check",
    "format": "oxfmt",
    "test": "vitest --passWithNoTests",
    "dev": "tsdown --watch src",
    "typecheck": "tsc",
    "lint": "oxlint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiberon-Labs/behave-graph",
    "directory": "packages/nodes/slack"
  },
  "bugs": "https://github.com/Kiberon-Labs/behave-graph/issues",
  "author": "kiberonlabsdev",
  "devDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "tsdown": "^0.16.5",
    "vite": "^7.2.4",
    "vitest": "^4.0.10"
  },
  "dependencies": {},
  "license": "ISC",
  "behaveGraph": {
    "manifest": "./dist/behave-graph.manifest.json"
  },
  "peerDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "@slack/socket-mode": "^2.0.0",
    "@slack/web-api": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@slack/socket-mode": {
      "optional": true
    },
    "@slack/web-api": {
      "optional": true
    }
  }
}
