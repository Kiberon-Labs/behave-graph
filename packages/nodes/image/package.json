{
  "name": "@kiberon-labs/behave-graph-nodes-image",
  "version": "2.0.0",
  "type": "module",
  "description": "ImageMagick-powered image manipulation nodes for behave-graph (resize, crop, color, filters, compositing and more).",
  "keywords": [
    "behave-graph",
    "behavior-graph",
    "nodes",
    "image",
    "imagemagick",
    "wasm",
    "image-processing",
    "visual-scripting"
  ],
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "behaveGraph": {
    "manifest": "./dist/behave-graph.manifest.json"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && behave-graph-manifest dist/manifest.source.js --out dist",
    "release": "npm publish --provenance",
    "check": "oxfmt --check",
    "format": "oxfmt",
    "test": "vitest --passWithNoTests",
    "dev": "tsdown --watch src",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiberon-Labs/behave-graph",
    "directory": "packages/nodes/image"
  },
  "bugs": "https://github.com/Kiberon-Labs/behave-graph/issues",
  "author": "kiberonlabsdev",
  "devDependencies": {
    "@kiberon-labs/behave-graph": "workspace:*",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.0.8",
    "tsdown": "^0.16.5",
    "vite": "^7.2.4",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.37",
    "iconoir-react": "^7.11.0",
    "zustand": "^5.0.8"
  },
  "license": "ISC",
  "peerDependencies": {
    "@kiberon-labs/behave-graph-flow": "workspace:*",
    "@kiberon-labs/behave-graph": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@kiberon-labs/behave-graph-flow": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}