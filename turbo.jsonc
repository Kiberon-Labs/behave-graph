{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    "**/.env.*local"
  ],
  "globalEnv": [],
  "tasks": {
    // Video package (packages/video): Remotion studio/render/voice/thumbnail.
    // "studio" (not "dev") so `turbo dev` doesn't sweep the studio up.
    "studio": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "render": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**"
      ],
      "cache": false
    },
    "thumbnail": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/thumbnail.png"
      ],
      "cache": false
    },
    "voice": {
      "cache": false
    },
    "image-demo": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "outputLogs": "new-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.demo-mono-ts",
        ".env.local"
      ]
    },
    // Website-specific build env is declared in packages/website/turbo.json so
    // PostHog settings affect only the documentation site's cache key.
    // Publishable packages opt in by defining a "release" script that
    // preflights the publish (echo 0). The actual publish is
    // a single root-level changeset publish, which needs the full CI env for
    // provenance, so it must stay outside turbo.
    "release": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ]
    },
    "coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx"
      ]
    },
    "format": {
      "cache": false
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    },
    "check": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
